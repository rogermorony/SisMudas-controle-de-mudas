<%- include("../partials/cabecalho", { titulo }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Munícipes cadastrados</h1>
  <a href="/municipes/add" class="btn btn-success">Novo cadastro</a>
</div>

<% if (bloqueado) { %>
  <div class="alert alert-danger" role="alert">
    Não é possível excluir este munícipe porque existem retiradas registradas.
  </div>
<% } %>

<% if (excluido) { %>
  <div class="alert alert-success" role="alert">
    Munícipe excluído com sucesso!
  </div>
<% } %>

<% if (atualizado) { %>
  <div class="alert alert-success" role="alert">
    Cadastro atualizado com sucesso!
  </div>
<% } %>

<form action="/municipes/lst" method="GET" class="mb-4">
  <div class="input-group">
    <input type="text" name="busca" class="form-control"
      placeholder="Pesquisar por nome ou CPF"
      value="<%= busca %>">

    <button type="submit" class="btn btn-success">Pesquisar</button>
    <a href="/municipes/lst" class="btn btn-secondary">Limpar</a>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped table-bordered align-middle">
    <thead>
      <tr>
        <th>Nome</th>
        <th>CPF</th>
        <th>Telefone</th>
        <th>Endereço</th>
        <th>Ação</th>
      </tr>
    </thead>

    <tbody>
      <% municipes.forEach(municipe => { %>
        <tr>
          <td><%= municipe.nome %></td>

          <td><%= municipe.cpf %></td>

          <td>
            <%= municipe.telefone || "Não informado" %>
          </td>

          <td>
            <% if (municipe.logradouro) { %>
              <div>
                <%= municipe.logradouro %>,
                <%= municipe.numero || "S/N" %>
                <%= municipe.complemento ? "- " + municipe.complemento : "" %>
              </div>

              <div class="text-secondary small">
                <%= municipe.bairro || "Bairro não informado" %> -
                <%= municipe.municipio || "Paulínia" %>
              </div>

              <div class="text-secondary small">
                CEP: <%= municipe.cep || "Não informado" %>
              </div>
            <% } else { %>
              Não informado
            <% } %>
          </td>

          <td>
            <div class="d-flex gap-2">
              <a href="/municipes/edit/<%= municipe._id %>"
                 class="btn btn-sm btn-outline-success">
                Editar
              </a>

              <button type="button"
                class="btn btn-sm btn-outline-danger"
                data-bs-toggle="modal"
                data-bs-target="#excluir<%= municipe._id %>">
                Excluir
              </button>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (municipes.length === 0) { %>
  <p>
    <%= busca ? "Nenhum munícipe encontrado." : "Nenhum munícipe cadastrado." %>
  </p>
<% } %>

<% municipes.forEach(municipe => { %>
  <div class="modal fade"
       id="excluir<%= municipe._id %>"
       tabindex="-1"
       aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">

        <div class="modal-header">
          <h2 class="modal-title fs-5">Excluir munícipe</h2>

          <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Fechar">
          </button>
        </div>

        <div class="modal-body">
          Tem certeza de que deseja excluir
          <strong><%= municipe.nome %></strong>?

          <p class="text-secondary mt-2 mb-0">
            Esta ação não poderá ser desfeita.
          </p>
        </div>

        <div class="modal-footer">
          <button type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">
            Cancelar
          </button>

          <form action="/municipes/delete/<%= municipe._id %>"
                method="POST">
            <button type="submit" class="btn btn-danger">
              Excluir munícipe
            </button>
          </form>
        </div>

      </div>
    </div>
  </div>
<% }) %>

<a href="/" class="btn btn-secondary">
  Voltar ao início
</a>

<%- include("../partials/rodape") %>
