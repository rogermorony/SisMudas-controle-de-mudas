<%- include("../partials/cabecalho", { titulo }) %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Histórico de Retiradas</h1>
    <a href="/retiradas/add" class="btn btn-success">Nova retirada</a>
  </div>

  <% if (excluido) { %>
    <div class="alert alert-success" role="alert">
      Retirada excluída com sucesso! Estoque atualizado.
    </div>
    <% } %>

      <% if (erroExclusao) { %>
        <div class="alert alert-danger" role="alert">
          Não foi possível excluir a retirada.
          Nenhuma alteração foi concluída.
        </div>
        <% } %>

          <% if (atualizado) { %>
            <div class="alert alert-success" role="alert">
              Retirada atualizada com sucesso! Estoque ajustado.
            </div>
            <% } %>

              <form action="/retiradas/lst" method="GET" class="mb-4">
                <div class="input-group">
                  <input type="text" name="busca" class="form-control" placeholder="Pesquisar por nome do munícipe"
                    value="<%= busca %>">

                  <button type="submit" class="btn btn-success">Pesquisar</button>
                  <a href="/retiradas/lst" class="btn btn-secondary">Limpar</a>
                </div>
              </form>

              <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle">
                  <thead>
                    <tr>
                      <th>Data</th>
                      <th>Munícipe</th>
                      <th>Espécie</th>
                      <th>Quantidade</th>
                      <th>Situação</th>
                      <th>Ação</th>
                    </tr>
                  </thead>

                  <tbody>
                    <% retiradas.forEach(retirada=> { %>
                      <tr>
                        <td>
                          <%= retirada.dataRetirada.toLocaleDateString("pt-BR", { timeZone: "America/Sao_Paulo" }) %>
                        </td>

                        <td>
                          <%= retirada.municipeId?.nome || "Não encontrado" %>
                        </td>

                        <td>
                          <% if (retirada.itens && retirada.itens.length> 0) { %>
                            <% retirada.itens.forEach(item=> { %>
                              <div>
                                <%= item.especieId?.nomePopular || "Não encontrada" %>
                              </div>
                              <% }) %>
                                <% } else { %>
                                  <%= retirada.especieId?.nomePopular || "Não encontrada" %>
                                    <% } %>
                        </td>

                        <td>
                          <% if (retirada.itens && retirada.itens.length> 0) { %>
                            <%= retirada.itens.reduce((total, item)=>
                              total + item.quantidade, 0) %>
                              <% } else { %>
                                <%= retirada.quantidade %>
                                  <% } %>
                        </td>

                        <td>
                          <%= retirada.situacao %>
                        </td>

                        <td>
                          <div class="d-flex gap-2">
                            <a href="/retiradas/edit/<%= retirada._id %>" class="btn btn-sm btn-outline-success">
                              Editar
                            </a>

                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                              data-bs-target="#excluir<%= retirada._id %>">
                              Excluir
                            </button>
                          </div>
                        </td>
                      </tr>
                      <% }) %>
                  </tbody>
                </table>
              </div>

              <% if (retiradas.length===0) { %>
                <p>
                  <%= busca ? "Nenhuma retirada encontrada." : "Nenhuma retirada registrada." %>
                </p>
                <% } %>

                  <% retiradas.forEach(retirada=> { %>
                    <div class="modal fade" id="excluir<%= retirada._id %>" tabindex="-1" aria-hidden="true">

                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">

                          <div class="modal-header">
                            <h2 class="modal-title fs-5">Excluir retirada</h2>

                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar">
                            </button>
                          </div>

                          <div class="modal-body">
                            Tem certeza de que deseja excluir a retirada de
                            <strong>
                              <%= retirada.municipeId?.nome || "Munícipe não encontrado" %>
                            </strong>?

                            <p class="text-secondary mt-2 mb-0">
                              Esta ação não poderá ser desfeita.
                              As mudas serão devolvidas ao estoque.
                            </p>
                          </div>

                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                              Cancelar
                            </button>

                            <form action="/retiradas/delete/<%= retirada._id %>" method="POST">
                              <button type="submit" class="btn btn-danger">
                                Excluir retirada
                              </button>
                            </form>
                          </div>

                        </div>
                      </div>
                    </div>
                    <% }) %>

                      <a href="/" class="btn btn-secondary">
                        Voltar ao início
                      </a>

                      <%- include("../partials/rodape") %>