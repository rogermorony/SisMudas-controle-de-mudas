<%- include("../partials/cabecalho", { titulo }) %>

  <h1 class="h3 mb-4">Cadastrar Espécie</h1>

  <form action="/especies/add" method="POST">

    <div class="mb-3">
      <label for="nomePopular" class="form-label">Nome popular</label>
      <input type="text" class="form-control" id="nomePopular" name="nomePopular" required>
    </div>

    <div class="mb-3">
      <label for="nomeCientifico" class="form-label">Nome científico</label>
      <input type="text" class="form-control" id="nomeCientifico" name="nomeCientifico">
    </div>

    <div class="mb-3">
      <label for="estoque" class="form-label">Quantidade disponível</label>
      <input type="number" class="form-control" id="estoque" name="estoque" min="0" step="1" value="0" required>
    </div>

    <div class="mb-3">
      <label for="ativa" class="form-label">Situação</label>
      <select class="form-select" id="ativa" name="ativa">
        <option value="true">Ativa</option>
        <option value="false">Inativa</option>
      </select>
    </div>

    <button type="submit" class="btn btn-success">Salvar</button>
    <a href="/" class="btn btn-secondary">Voltar</a>

  </form>

  <%- include("../partials/rodape") %>